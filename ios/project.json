{
  "name": "XLatch",
  "options": {
    "bundleIdPrefix": "com.byteowlz",
    "deploymentTarget": {
      "iOS": "17.0"
    }
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "DEVELOPMENT_TEAM": "K8RV7BFSRS",
      "CODE_SIGN_STYLE": "Automatic",
      "MARKETING_VERSION": "0.1.0",
      "CURRENT_PROJECT_VERSION": "1",
      "TARGETED_DEVICE_FAMILY": "1,2",
      "ENABLE_USER_SCRIPT_SANDBOXING": true,
      "GENERATE_INFOPLIST_FILE": false,
      "SWIFT_EMIT_LOC_STRINGS": true,
      "OTHER_LDFLAGS": "$(inherited) -ObjC"
    }
  },
  "targets": {
    "XLatch": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "App",
        "Shared"
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.byteowlz.xlatch",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon"
        }
      },
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "xlatch",
          "XLatchKeychainGroup": "$(AppIdentifierPrefix)com.byteowlz.xlatch.shared",
          "UILaunchScreen": {},
          "NSCameraUsageDescription": "Scan a pairing code from your xlatch server.",
          "NSLocalNetworkUsageDescription": "Connect to your paired xlatch server to send actions and retrieve results.",
          "NSAppTransportSecurity": {
            "NSAllowsLocalNetworking": true
          },
          "UIApplicationSceneManifest": {
            "UIApplicationSupportsMultipleScenes": false
          },
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "entitlements": {
        "path": "App/XLatch.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.com.byteowlz.xlatch"
          ],
          "keychain-access-groups": [
            "$(AppIdentifierPrefix)com.byteowlz.xlatch.shared"
          ]
        }
      },
      "dependencies": [
        {
          "target": "XLatchShare",
          "embed": true
        }
      ]
    },
    "XLatchShare": {
      "type": "app-extension",
      "platform": "iOS",
      "sources": [
        "Share",
        "Shared"
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.byteowlz.xlatch.share",
          "APPLICATION_EXTENSION_API_ONLY": true,
          "SKIP_INSTALL": true
        }
      },
      "info": {
        "path": "Share/Info.plist",
        "properties": {
          "CFBundleDisplayName": "xlatch",
          "XLatchKeychainGroup": "$(AppIdentifierPrefix)com.byteowlz.xlatch.shared",
          "NSLocalNetworkUsageDescription": "Send shared content to your paired xlatch server.",
          "NSAppTransportSecurity": {
            "NSAllowsLocalNetworking": true
          },
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.share-services",
            "NSExtensionPrincipalClass": "$(PRODUCT_MODULE_NAME).ShareViewController",
            "NSExtensionAttributes": {
              "NSExtensionActivationRule": {
                "NSExtensionActivationSupportsText": true,
                "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
                "NSExtensionActivationSupportsImageWithMaxCount": 1,
                "NSExtensionActivationSupportsMovieWithMaxCount": 1,
                "NSExtensionActivationSupportsFileWithMaxCount": 1
              }
            }
          }
        }
      },
      "entitlements": {
        "path": "Share/XLatchShare.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.com.byteowlz.xlatch"
          ],
          "keychain-access-groups": [
            "$(AppIdentifierPrefix)com.byteowlz.xlatch.shared"
          ]
        }
      }
    },
    "XLatchTests": {
      "type": "bundle.unit-test",
      "platform": "iOS",
      "sources": [
        "Tests"
      ],
      "dependencies": [
        {
          "target": "XLatch"
        }
      ],
      "settings": {
        "base": {
          "GENERATE_INFOPLIST_FILE": true
        }
      }
    }
  },
  "schemes": {
    "XLatch": {
      "build": {
        "targets": {
          "XLatch": "all"
        }
      },
      "test": {
        "targets": [
          "XLatchTests"
        ]
      }
    }
  }
}
